{
  "name": "dsh-voice-hotkey",
  "version": "1.2.0",
  "type": "module",
  "description": "Minimal push-to-talk voice input for DeepSeek Harness: Alt+V toggles the official Voice Input recorder, silence stops it, the transcript lands in the composer with focus intact.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "speech-to-text",
    "push-to-talk",
    "hotkey"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.1 || ^0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiplashf/dsh-voice-hotkey.git"
  },
  "homepage": "https://github.com/whiplashf/dsh-voice-hotkey#readme",
  "bugs": {
    "url": "https://github.com/whiplashf/dsh-voice-hotkey/issues"
  },
  "author": "whiplashf"
}
